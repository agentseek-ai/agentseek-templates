# System One decision models + chat provider. All keys stay on the server.
# Default: fill ONLY OPENAI_API_KEY with your SiliconFlow China key.
# Chinese configuration guide follows the settings below.
OPENAI_API_KEY=
OPENAI_API_BASE={{ cookiecutter.chat_api_base }}

# SiliconFlow decision models: semif (default), kev-4b.
# Pick per run in the UI; the same selection handles routing and tool risk.
# Leave this key empty to reuse OPENAI_API_KEY ONLY when chat points to
# api.siliconflow.cn. If you change chat providers, fill this separately.
SILICONFLOW_API_KEY=
# Root URL only. The integration appends /v1/systemone; do not duplicate it.
SILICONFLOW_BASE_URL=https://api.siliconflow.cn

# Optional official Jev. Fill only if selecting Jev in the console.
# Get a TypeSafe key at https://console.typesafe.ai.
# Never put a TypeSafe key in the SiliconFlow fields or vice versa.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# Chat models are separate from decision models. Use IDs your account supports.
# Switching providers: change the key, endpoint, BOTH IDs and JSON options.
JEV_FAST_MODEL={{ cookiecutter.fast_model }}
JEV_POWERFUL_MODEL={{ cookiecutter.powerful_model }}
# Use '{}' when your chat provider does not support enable_thinking.
CHAT_MODEL_EXTRA_BODY='{"enable_thinking":false}'

# Embedded persistence for local development.
SEEKDB_EMBED=true
SEEKDB_EMBED_DIR="~/.agentseek/{{ cookiecutter.project_slug }}/seekdb"
OCEANBASE_DB_NAME=test

# Optional tracing. Live runs send context to the selected decision provider.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_PROJECT={{ cookiecutter.project_slug }}

# 中文配置说明
# 默认只需在 OPENAI_API_KEY 填写硅基流动中国站密钥。
# SemIf / Kev-4B 做路由与风险判断；对话模型生成解释。
# 对话服务为硅基流动时，SILICONFLOW_API_KEY 可留空复用密钥。
# 对话改用其他服务商时，必须单独填写 SILICONFLOW_API_KEY。
# SILICONFLOW_BASE_URL 只填根地址，不要填 /v1 或完整请求路径。
# 选择官方 Jev 才需填写 TYPESAFE_API_KEY；硅基流动密钥不能调用官方 Jev。
# 更换对话服务商时，同步修改 OPENAI_API_KEY、OPENAI_API_BASE、
# JEV_FAST_MODEL、JEV_POWERFUL_MODEL 和 CHAT_MODEL_EXTRA_BODY。
# 不支持 enable_thinking 时，将 CHAT_MODEL_EXTRA_BODY 设为 '{}'。
# 修改 .env 后重启后端。不要将任何密钥写入 frontend/.env。
