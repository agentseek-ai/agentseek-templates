# Jev Harness provider configuration. Keep all keys on the server.
# 1. Jev classifier: get your own key from https://console.typesafe.ai.
# This is separate from the SiliconFlow chat provider credential below.
# Keep TYPESAFE_BASE_URL unchanged unless you use another TypeSafe endpoint.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai

# 2. SiliconFlow chat provider: fill your own key (NOT the Jev key).
# Both routes share this credential and this Chat Completions endpoint.
# Replace the key, base URL, BOTH model IDs, and provider options together
# when switching to another OpenAI-compatible provider. Restart the backend.
OPENAI_API_KEY=
OPENAI_API_BASE={{ cookiecutter.chat_api_base }}

# 3. Exact model IDs supported by your provider and account.
JEV_FAST_MODEL={{ cookiecutter.fast_model }}
JEV_POWERFUL_MODEL={{ cookiecutter.powerful_model }}

# 4. Provider options must be a JSON object. This demo disables thinking.
# Set to '{}' if your provider does not support SiliconFlow's enable_thinking.
CHAT_MODEL_EXTRA_BODY='{"enable_thinking":false}'

# 中文配置说明：默认使用硅基流动 DeepSeek V4 Flash / Pro。
# 1. TYPESAFE_API_KEY：Jev 分类服务密钥；通常无需修改 TYPESAFE_BASE_URL。
# 2. OPENAI_API_KEY：填写你的硅基流动密钥，不是 Jev Key；两个模型共用。
# 3. JEV_FAST_MODEL / JEV_POWERFUL_MODEL：简单 / 复杂任务的模型，使用完整 ID。
# 4. CHAT_MODEL_EXTRA_BODY：服务商 JSON 参数；默认关闭 SiliconFlow 思考模式。
# 更换服务商：同时修改密钥、接口地址、两个模型 ID 和参数；Jev 配置保持独立。
# 不支持 enable_thinking 时，将 CHAT_MODEL_EXTRA_BODY 设为 '{}'。修改后重启后端。

SEEKDB_EMBED=true
SEEKDB_EMBED_DIR="~/.agentseek/{{ cookiecutter.project_slug }}/seekdb"
OCEANBASE_DB_NAME=test

# Optional tracing / 可选追踪；默认关闭。Never put keys in frontend/.env.
# 不要将密钥写入 frontend/.env。Live runs send prompts/tool context to TypeSafe.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_PROJECT={{ cookiecutter.project_slug }}
