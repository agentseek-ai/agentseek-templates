# System One decision models + chat provider. All keys stay on the server.
# 默认：SemIf 做路由与风险判断，DeepSeek Flash / Pro 生成回复。
# Default: fill ONLY OPENAI_API_KEY with your SiliconFlow China key.
# 默认只需在 OPENAI_API_KEY 填写你的硅基流动中国站密钥。
OPENAI_API_KEY=
OPENAI_API_BASE={{ cookiecutter.chat_api_base }}

# SiliconFlow decision models: semif (default), kev-4b, diffusiongemma.
# Pick per run in the bilingual UI; the same selection handles routing + risk.
# 每次运行在界面选择决策模型，模型路由与风险检查共用该选择。
# Leave this key empty to reuse OPENAI_API_KEY ONLY when chat points to
# api.siliconflow.cn. If you change chat providers, fill this separately.
# 对话服务为硅基流动时可留空复用密钥；对话改用其他服务商时必须单独填写。
SILICONFLOW_API_KEY=
# Root URL only. The integration appends /v1/systemone (do not duplicate it).
# 只填根地址，程序自动追加 /v1/systemone。不要填 /v1 或完整请求路径。
SILICONFLOW_BASE_URL=https://api.siliconflow.cn

# Optional official Jev. Fill only if selecting Jev in the console.
# 可选：选择官方 Jev 才需填写，从 https://console.typesafe.ai 获取。
# Never put a TypeSafe key in the SiliconFlow fields (or vice versa).
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# Chat models are separate from the decision model; use IDs your account supports.
# 对话模型与决策模型是两回事；下列模型 ID 可替换为账号支持的其他候选模型。
JEV_FAST_MODEL={{ cookiecutter.fast_model }}
JEV_POWERFUL_MODEL={{ cookiecutter.powerful_model }}
CHAT_MODEL_EXTRA_BODY='{"enable_thinking":false}'
# Switching chat providers: change OPENAI_API_KEY, OPENAI_API_BASE, BOTH model
# IDs and CHAT_MODEL_EXTRA_BODY together. Use '{}' if enable_thinking unsupported.
# 更换对话服务商时同时修改密钥、接口、两个模型 ID 和参数；不支持思考开关时填 '{}'。
# Restart the backend after editing .env / 修改 .env 后重启后端。

SEEKDB_EMBED=true
SEEKDB_EMBED_DIR="~/.agentseek/{{ cookiecutter.project_slug }}/seekdb"
OCEANBASE_DB_NAME=test

# Optional tracing / 可选追踪；默认关闭。Never put keys in frontend/.env.
# 不要将密钥写入 frontend/.env。Live runs send prompts/tool context to the selected decision provider.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_PROJECT={{ cookiecutter.project_slug }}
