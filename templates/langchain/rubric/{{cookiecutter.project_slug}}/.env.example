# --- Live Model provider ---------------------------------------------------
# Choose one provider and configure only its credential block below.
# `google_genai` is accepted as a compatibility alias for `google`.
AGENTSEEK_MODEL_PROVIDER={{ cookiecutter.default_provider }}
# Worker model used to draft and revise rubric content in Live Model mode.
AGENTSEEK_MODEL={{ cookiecutter.worker_model }}
# Grader model used to grade evidence in Live Model mode.
RUBRIC_GRADER_MODEL={{ cookiecutter.grader_model }}

# OpenAI / OpenAI-compatible
# Required only when AGENTSEEK_MODEL_PROVIDER=openai.
# Leave OPENAI_API_BASE empty to use the official OpenAI endpoint.
OPENAI_API_KEY=
OPENAI_API_BASE=

# Anthropic / Anthropic-compatible
# Required only when AGENTSEEK_MODEL_PROVIDER=anthropic.
# Leave ANTHROPIC_API_URL empty to use the official Anthropic endpoint.
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=

# Gemini / Google-compatible
# Required only when AGENTSEEK_MODEL_PROVIDER=google or google_genai.
# Leave GOOGLE_API_BASE empty to use the official Gemini Developer API endpoint.
GOOGLE_API_KEY=
GOOGLE_API_BASE=

# --- LangSmith (optional tracing) -----------------------------------------
# Get an API key at https://smith.langchain.com/settings/apikeys
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# Set LANGSMITH_ENDPOINT for APAC or other non-default regions, e.g.:
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
