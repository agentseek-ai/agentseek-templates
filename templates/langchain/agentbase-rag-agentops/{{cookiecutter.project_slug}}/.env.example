# --- Model ---------------------------------------------------------------
AGENTSEEK_MODEL={{ cookiecutter.default_model }}
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint.
OPENAI_API_BASE=

# --- AgentBase knowledge-base retrieval --------------------------------
# The SDK endpoint includes /v1.
AGENTBASE_ENDPOINT=https://appbuild-sit.oceanbase.com/v1
AGENTBASE_PROJECT_ID=
AGENTBASE_API_KEY=
AGENTBASE_KNOWLEDGE_BASE_ID={{ cookiecutter.knowledge_base_id }}
AGENTBASE_RAG_LIMIT={{ cookiecutter.retrieval_limit }}

# --- AppBase AgentOps ---------------------------------------------------
# The AgentOps SDK accepts this /v1 base URL and normalizes its traces URL.
AGENTBASE_AGENTOPS_ENDPOINT=https://appbuild-sit.oceanbase.com/v1
AGENTBASE_AGENTOPS_SERVICE_NAME={{ cookiecutter.project_slug }}
AGENTBASE_AGENTOPS_CAPTURE_CONTENT=false
# AGENTBASE_AGENTOPS_ENABLED=true
# AGENTBASE_AGENTOPS_DEBUG=false

# --- Browser -------------------------------------------------------------
VITE_LANGGRAPH_API_URL=http://127.0.0.1:2024

# --- AgentSeek API local persistence ------------------------------------
# The API runtime needs these values even though RAG data lives in AgentBase.
# Embedded mode avoids requiring a separate local MySQL/SeekDB server.
SEEKDB_MODE=embedded
SEEKDB_PATH={{ cookiecutter.seekdb_path }}
SEEKDB_DB_NAME={{ cookiecutter.seekdb_db_name }}
SEEKDB_EMBED=true
SEEKDB_EMBED_DIR={{ cookiecutter.seekdb_path }}
OCEANBASE_DB_NAME={{ cookiecutter.seekdb_db_name }}
