AGENTSEEK_MODEL_PROVIDER={{ cookiecutter.default_model_provider }}
AGENTSEEK_MODEL={{ cookiecutter.default_model }}
POWERCONTEXT_URL={{ cookiecutter.powercontext_url }}
# Optional existing Server-owned Scope ID; otherwise use Create project memory in the UI.
POWERCONTEXT_SCOPE_ID={{ cookiecutter.powercontext_scope }}
POWERCONTEXT_PROJECT_KEY={{ cookiecutter.project_slug }}
POWERCONTEXT_TOKEN=
POWERCONTEXT_MAX_BYTES={{ cookiecutter.powercontext_max_bytes }}

# --- AgentSeek API persistence --------------------------------------------
# Embedded local SeekDB used by the AgentSeek API runtime for conversation
# checkpoints. Override the directory to keep data elsewhere.
SEEKDB_EMBED=true
SEEKDB_EMBED_DIR=~/.agentseek/{{ cookiecutter.project_slug }}/seekdb
OCEANBASE_DB_NAME=test

# Provider credentials: fill only the selected provider's block.
OPENAI_API_KEY=
OPENAI_API_BASE=
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=
GOOGLE_API_KEY=
GOOGLE_API_BASE=
