# Select one provider and fill only its credential block.
AGENTSEEK_MODEL_PROVIDER={{ cookiecutter.default_model_provider }}
AGENTSEEK_MODEL={{ cookiecutter.default_model }}
# Compatibility aliases: DEEPAGENTS_MODEL and BUB_MODEL.
# Optional shared request throttle for gateways with strict burst limits.
# Example: 0.5 permits one model request every two seconds.
AGENTSEEK_MODEL_REQUESTS_PER_SECOND=

# OpenAI / OpenAI-compatible
OPENAI_API_KEY=
# Leave blank for the official OpenAI endpoint.
OPENAI_API_BASE=

# Anthropic / Anthropic-compatible
ANTHROPIC_API_KEY=
# Leave blank for the official Anthropic endpoint.
ANTHROPIC_API_URL=

# Gemini / Google-compatible
GOOGLE_API_KEY=
# Leave blank for the official Gemini Developer API endpoint.
GOOGLE_API_BASE=

# Some OpenAI-compatible gateways emit large tool-call chunks with long gaps.
# Set to 0 to disable this client-side timeout override.
LANGCHAIN_OPENAI_STREAM_CHUNK_TIMEOUT_S=300

# Optional LangSmith tracing. Nested subagent runs are easiest to inspect there.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=dynamic-subagents-lab
# Use the APAC endpoint when your key belongs to that region.
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
