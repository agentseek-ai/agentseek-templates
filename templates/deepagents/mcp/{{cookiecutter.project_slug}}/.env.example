# Model configuration for the generated DeepAgents application.
AGENTSEEK_MODEL_PROVIDER={{ cookiecutter.default_model_provider }}
AGENTSEEK_MODEL={{ cookiecutter.default_model }}

# Required by `agentseek doctor`; passed to the selected provider adapter.
AGENTSEEK_MODEL_API_KEY=

# Optional provider-native credential fallbacks for direct runtime use.

# AgentSeek API embedded checkpoint persistence.
SEEKDB_EMBED=true
SEEKDB_EMBED_DIR=~/.agentseek/{{ cookiecutter.project_slug }}/seekdb
OCEANBASE_DB_NAME=test
OPENAI_API_KEY=
# Default course gateway. Clear this for the official OpenAI endpoint.
OPENAI_API_BASE=https://api.siliconflow.cn/v1
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=
GOOGLE_API_KEY=
GOOGLE_API_BASE=

# Optional LangSmith tracing. Keep disabled unless a valid key is configured.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT={{ cookiecutter.project_slug }}
# Set LANGSMITH_ENDPOINT for APAC or other non-default regions, e.g.:
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
