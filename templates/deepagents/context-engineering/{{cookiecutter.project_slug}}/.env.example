# Choose one generic protocol. Fill only its model key plus the Querit search key.
AGENTSEEK_MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Accepted base alias when canonical URL is absent: OPENAI_API_BASE.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Accepted base alias when canonical URL is absent: ANTHROPIC_API_URL.
QUERIT_API_KEY=
# Optional separate model catalog base for SDK models.list; blank reuses inference base.
AGENTSEEK_MODELS_BASE_URL=
# Local compatible servers may use HTTP loopback, e.g. http://127.0.0.1:8000/v1.
# For a server without authentication, use a non-secret placeholder key such as local.
# Choose exact model IDs independently in the browser; no model presets are stored here.
# Shared per-model-call output-token cap for both sides (128..32768; default 3000).
# The selected endpoint/model must support the configured value; reasoning may use this budget.
CONTEXT_LAB_MAX_OUTPUT_TOKENS=3000
# Shared graph step cap (8..256) and whole-run timeout in seconds (30..1800).
CONTEXT_LAB_RECURSION_LIMIT=32
CONTEXT_LAB_RUN_TIMEOUT_SECONDS=180

# Optional LangSmith tracing. Disabled by default; model/search keys are never trace metadata.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_PROJECT={{ cookiecutter.project_slug }}
CONTEXT_LAB_PORT={{ cookiecutter.port }}
